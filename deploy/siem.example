#!/bin/sh
# Copy to /usr/local/bin/siem and chmod 755.
# This box is systemd, not Node — do not wrap the Go binary in PM2.

svc=gpesiem

case "${1:-}" in
  status)
    systemctl is-active "$svc" nginx
    systemctl --no-pager --full status "$svc"
    ;;
  restart)
    systemctl restart "$svc"
    systemctl is-active "$svc"
    ;;
  restart-all)
    systemctl restart "$svc" nginx
    systemctl is-active "$svc" nginx
    ;;
  logs)
    exec journalctl -u "$svc" -n "${2:-80}" -f
    ;;
  version)
    command -v gpesiem >/dev/null && gpewebdefender version
    systemctl is-active "$svc" nginx
    ;;
  *)
    echo "siem status | restart | restart-all | logs [n] | version" >&2
    exit 2
    ;;
esac
