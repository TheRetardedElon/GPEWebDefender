# Copy to /etc/gpewebdefender/env on the manager and each agent (mode 640).
# Generate a token on the box, e.g. openssl rand -base64 32
# Never commit a filled copy.

GWD_TOKEN=replace-me
# Optional. name=lat,lon or name=ISO, semicolon-separated. Names match agent --name.
# GWD_HOMES=web-1=40.7,-74.0;edge-eu=DE
